# 复制这个文件为 .env（cp .env.example .env），然后在 .env 里填入你自己的 key。
# .env 已经在 .gitignore 里，不会被提交。

YOUTUBE_API_KEY=

# 可选：单次分析抓取的顶层评论条数上限（默认 1000）。超过这个数的视频只取前面
# 「热门」排序靠前的那部分，调大能覆盖更热门的视频，代价是分析耗时和 API 配额都会涨。
MAX_TOP_LEVEL_COMMENTS=1000

# Phase 2（可选）：DeepSeek key，在 platform.deepseek.com 申请，支持支付宝/微信支付充值
DEEPSEEK_API_KEY=
